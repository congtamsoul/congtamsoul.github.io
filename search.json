---
layout: null
permalink: /search.json
sitemap: false
---
[
{%- assign searchable_content = site.posts | concat: site.pages | where_exp: "item", "item.title and item.url != '/search/' and item.url != '/search.json' and item.layout != 'redirect'" -%}
{%- for item in searchable_content %}
  {
    "title": {{ item.title | strip_html | normalize_whitespace | jsonify }},
    "url": {{ item.url | relative_url | jsonify }},
    "type": {% if item.layout == 'post' %}"article"{% else %}"page"{% endif %},
    "summary": {{ item.description | default: item.summary | strip_html | normalize_whitespace | jsonify }},
    "tags": {{ item.tags | join: ' ' | jsonify }},
    "content": {{ item.content | strip_html | normalize_whitespace | jsonify }}
  }{% unless forloop.last %},{% endunless %}
{%- endfor %}
]
